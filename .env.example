# Copy to .env (git-ignored) and fill in.

# Folder the agents work in; mounted read-write at the same path inside every container.
# Default: $HOME/workarea/tmp
#WORKSPACE=/home/you/workarea/tmp

# claude: long-lived token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# opencode / kilo / goose: key for the local LiteLLM proxy (~/workarea/fox/openai-proxy).
LITELLM_MASTER_KEY=

# Models served by the proxy (any model_name in the proxy's litellm_config.yaml). Default: nemotron-3-ultra.
# (claude-, codex- and grok-proxy, and their -locked versions, use these too.) agy-proxy has no setting here: agy only asks for Gemini names, and LiteLLM's model_group_alias picks the real model.
#CLAUDE_PROXY_MODEL=nemotron-3-ultra
#OPENCODE_MODEL=nemotron-3-ultra
#KILO_MODEL=nemotron-3-ultra
#GOOSE_MODEL=nemotron-3-ultra
#CODEX_PROXY_MODEL=nemotron-3-ultra
#GROK_PROXY_MODEL=nemotron-3-ultra
# grok-proxy / grok-locked: the proxy model's context window (grok times auto-compaction by it). Default 128000.
#GROK_PROXY_CONTEXT_WINDOW=128000

# agy (Google sign-in): starting model. Default gemini-4-argon-high; the server's own default is gemini-3.8-flash-high.
#AGY_MODEL=gemini-4-argon-high

# muse: model id for `muse serve --model` (default: Muse's own default).
#MUSE_MODEL=

# ---- Locked profile (optional; docs/SECURITY.md) ----
# Where llm-gateway sends model calls, and the credential it adds (agents never see it). Defaults: the LiteLLM proxy
# above and LITELLM_MASTER_KEY.
#LOCKED_LLM_UPSTREAM=http://llm-proxy:8000
#LOCKED_LLM_KEY=
# The Docker network on which llm-gateway can reach LOCKED_LLM_UPSTREAM (default: openai-proxy_default).
#LOCKED_UPSTREAM_NETWORK=openai-proxy_default
# rw (default) or ro: whether locked agents may change the open folder.
#LOCKED_WORKSPACE_MODE=rw
