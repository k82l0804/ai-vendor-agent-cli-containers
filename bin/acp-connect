#!/usr/bin/env bash
# One ACP connection in a new container that mounts the folder this is started from (the ACP client starts agents in
# the open VS Code folder) at the same path, and is removed on disconnect. Usage: acp-connect <service>
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
svc=${1:?usage: acp-connect <service>}
dir=$(pwd -P)
# No folder open: the client falls back to its own cwd. Never mount a home folder or the root as the workspace.
case "$dir" in
  /|/home|/root|"$HOME")
    dir="${ACP_DEFAULT_DIR:-$HOME/workarea/tmp}"
    echo "acp-connect: no project folder open; using $dir" >&2 ;;
esac
# WORKSPACE in the environment overrides .env, so compose mounts this folder and tells acp-run about it.
export WORKSPACE="$dir"
locked=()
deps=(--no-deps)
# Locked profile: add its compose file, and let compose start llm-gateway and egress if they aren't running.
if [[ "$svc" == *-locked ]]; then
  locked=(--locked)
  deps=()
  # Podman 4.x reports no NetworkID for a container's networks, so Compose sees a change and recreates running
  # containers on every run/up, which would restart llm-gateway and egress under other open sessions. Start them
  # only if they aren't running (stdout stays clean for ACP), then leave them alone.
  if [ "$("$here/bin/acp-compose" --engine)" = podman ]; then
    "$here/bin/acp-compose" --locked up -d --no-recreate --quiet-pull llm-gateway egress >&2
    deps=(--no-deps)
  fi
fi
# bin/acp-compose picks Docker or Podman.
exec "$here/bin/acp-compose" "${locked[@]}" run --rm -T "${deps[@]}" --quiet-pull "$svc" acp-run
